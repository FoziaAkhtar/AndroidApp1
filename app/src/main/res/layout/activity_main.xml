<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4B8"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- =================================================
         TITLE
         ================================================= -->

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🎈 TAP COUNTER"
        android:textColor="#222222"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- =================================================
         TIMER CARD
         ================================================= -->

    <TextView
        android:id="@+id/timerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="TIME"
        android:textColor="#555555"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20"
        android:textColor="#D62828"
        android:textSize="42sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timerLabel" />

    <TextView
        android:id="@+id/secondsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECONDS"
        android:textColor="#555555"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timerText" />

    <!-- =================================================
         SCORE
         ================================================= -->

    <TextView
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0"
        android:textColor="#1565C0"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/secondsLabel" />

    <TextView
        android:id="@+id/tapsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAPS"
        android:textColor="#555555"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/countText" />

    <!-- =================================================
         GAME AREA
         ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#FFF9DD"
        app:layout_constraintBottom_toTopOf="@id/resetButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tapsLabel">

        <!-- =================================================
             BALLOON
             ================================================= -->

        <ImageButton
            android:id="@+id/tapButton"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Tap the balloon"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baloon_button"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- =================================================
             TAP MESSAGE
             ================================================= -->

        <TextView
            android:id="@+id/tapText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP!"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tapButton"
            app:layout_constraintEnd_toEndOf="@id/tapButton"
            app:layout_constraintStart_toStartOf="@id/tapButton"
            app:layout_constraintTop_toTopOf="@id/tapButton" />

        <!-- =================================================
             GAME OVER
             ================================================= -->

        <TextView
            android:id="@+id/gameOverText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="🎉 GAME OVER! 🎉"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- =================================================
         RESET GAME
         ================================================= -->

    <Button
        android:id="@+id/resetButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginEnd="6dp"
        android:text="🔄  RESET GAME"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/topScoresTitle"
        app:layout_constraintEnd_toStartOf="@id/resetScoresButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.46" />

    <!-- =================================================
         RESET SCORES
         ================================================= -->

    <Button
        android:id="@+id/resetScoresButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:text="🗑️  RESET SCORES"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/topScoresTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/resetButton"
        app:layout_constraintWidth_percent="0.46" />

    <!-- =================================================
         LEADERBOARD TITLE
         ================================================= -->

    <TextView
        android:id="@+id/topScoresTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🏆 TOP 5 SCORES"
        android:textColor="#222222"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/topScoresText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- =================================================
         LEADERBOARD
         ================================================= -->

    <TextView
        android:id="@+id/topScoresText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="1. ---&#10;2. ---&#10;3. ---&#10;4. ---&#10;5. ---"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

